
---
import SiteTitle from 'virtual:starlight/components/SiteTitle';
import ThemeSelect from 'virtual:starlight/components/ThemeSelect';
---

<header class="dp-header">
  <div class="dp-header-inner">

    <!-- LOGOTIPO -->
    <div class="dp-brand">
      <SiteTitle />
    </div>

    <!-- NAVEGAÇÃO DESKTOP -->
    <nav class="dp-navigation" aria-label="Navegação principal">

      <a href="/" class="dp-nav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/>
        </svg>
        <span>Início</span>
      </a>

      <details class="dp-dropdown">
        <summary class="dp-nav-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span>Áreas</span>
          <svg class="dp-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>

        <div class="dp-dropdown-menu">
          <a href="/areas/estruturas/" class="dp-dropdown-item">
            <strong>Estruturas</strong>
            <span>Materiais e sistemas estruturais</span>
          </a>

          <a href="/areas/cargas/" class="dp-dropdown-item">
            <strong>Cargas</strong>
            <span>Esforços, solicitações e distribuição de cargas</span>
          </a>

          <div class="dp-dropdown-item dp-disabled">
            <strong>Aeroelasticidade</strong>
            <span>Em desenvolvimento</span>
          </div>

          <div class="dp-dropdown-item dp-disabled">
            <strong>Aerodinâmica</strong>
            <span>Em desenvolvimento</span>
          </div>
        </div>
      </details>

      <a href="/#sobre" class="dp-nav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 11v5"/>
          <path d="M12 7h.01"/>
        </svg>
        <span>Sobre</span>
      </a>

    </nav>

    <!-- PESQUISA DESKTOP -->
    <form class="dp-search dp-search-desktop" action="/search/" method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.8"/>
        <path d="m16 16 5 5"/>
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Pesquisar aulas e materiais..."
        aria-label="Pesquisar aulas e materiais"
      />
    </form>

    <!-- SELETOR DE TEMA -->
    <div class="dp-theme-select" aria-label="Alterar aparência do site">
      <ThemeSelect />
    </div>

    <!-- BOTÃO DO MENU MOBILE -->
    <button
      class="dp-mobile-toggle"
      type="button"
      aria-label="Abrir menu"
      aria-expanded="false"
      aria-controls="dp-mobile-menu"
    >
      <svg class="dp-menu-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M4 6h16M4 12h16M4 18h16"/>
      </svg>
      <svg class="dp-close-icon" viewBox="0 0 24 24" aria-hidden="true">
        <path d="m6 6 12 12M18 6 6 18"/>
      </svg>
    </button>

  </div>

  <!-- MENU MOBILE -->
  <div class="dp-mobile-menu" id="dp-mobile-menu" hidden>

    <nav class="dp-mobile-navigation" aria-label="Navegação para celular">

      <a href="/" class="dp-mobile-link">
        Início
      </a>

      <details class="dp-mobile-dropdown">
        <summary>
          Áreas
          <svg class="dp-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>

        <div class="dp-mobile-submenu">
          <a href="/areas/estruturas/">Estruturas</a>
          <a href="/areas/cargas/">Cargas</a>
          <span class="dp-mobile-disabled">Aeroelasticidade — Em desenvolvimento</span>
          <span class="dp-mobile-disabled">Aerodinâmica — Em desenvolvimento</span>
        </div>
      </details>

      <a href="/#sobre" class="dp-mobile-link">
        Sobre
      </a>

    </nav>

    <!-- PESQUISA MOBILE -->
    <form class="dp-search dp-search-mobile" action="/search/" method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.8"/>
        <path d="m16 16 5 5"/>
      </svg>
      <input
        type="search"
        name="q"
        placeholder="Pesquisar aulas e materiais..."
        aria-label="Pesquisar aulas e materiais"
      />
    </form>

  </div>
</header>

<style>
  /* CABEÇALHO */

  .dp-header {
    position: relative;
    z-index: 100;
    width: 100%;
    background: var(--sl-color-bg);
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .dp-header-inner {
    width: 100%;
    min-height: 76px;
    padding: 0 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    box-sizing: border-box;
  }

  .dp-brand {
    flex-shrink: 0;
  }

  /* NAVEGAÇÃO DESKTOP */

  .dp-navigation {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .dp-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--sl-color-text);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .dp-nav-link:hover {
    color: #1769AA;
  }

  .dp-nav-link svg,
  .dp-search svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  /* MENU SUSPENSO DESKTOP */

  .dp-dropdown {
    position: relative;
  }

  .dp-dropdown summary {
    list-style: none;
    cursor: pointer;
  }

  .dp-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dp-chevron {
    width: 15px !important;
    height: 15px !important;
    transition: transform 0.2s ease;
  }

  .dp-dropdown[open] .dp-chevron {
    transform: rotate(180deg);
  }

  .dp-dropdown-menu {
    position: absolute;
    top: calc(100% + 18px);
    left: -15px;
    width: 245px;
    padding: 8px;
    background: var(--sl-color-bg);
    border: 1px solid var(--sl-color-hairline);
    border-radius: 12px;
    box-shadow: 0 10px 28px rgba(16,36,61,0.14);
    z-index: 100;
  }

  .dp-dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    color: var(--sl-color-text);
    transition: background 0.2s ease;
  }

  a.dp-dropdown-item:hover {
    background: var(--sl-color-gray-6);
  }

  .dp-dropdown-item strong {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .dp-dropdown-item span {
    font-size: 0.78rem;
    color: var(--sl-color-gray-3);
  }

  .dp-disabled {
    opacity: 0.65;
    cursor: default;
  }

  /* PESQUISA */

  .dp-search {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 1rem;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 10px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-gray-3);
    box-sizing: border-box;
  }

  .dp-search-desktop {
    width: min(340px, 30%);
    min-width: 190px;
  }

  .dp-search:focus-within {
    border-color: #1769AA;
    box-shadow: 0 0 0 3px rgba(23,105,170,0.12);
  }

  .dp-search input {
    width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: var(--sl-color-text);
    font: inherit;
    font-size: 0.88rem;
  }

  .dp-search input::placeholder {
    color: var(--sl-color-gray-3);
  }

  /* SELETOR DE TEMA */

  .dp-theme-select {
    display: flex;
    align-items: center;
    flex-shrink: 0;
  }

  /* BOTÃO MOBILE */

  .dp-mobile-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    padding: 0;
    border: 1px solid var(--sl-color-hairline);
    border-radius: 9px;
    background: var(--sl-color-gray-6);
    color: var(--sl-color-text);
    cursor: pointer;
  }

  .dp-mobile-toggle svg {
    width: 23px;
    height: 23px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .dp-close-icon {
    display: none;
  }

  .dp-mobile-toggle[aria-expanded="true"] .dp-menu-icon {
    display: none;
  }

  .dp-mobile-toggle[aria-expanded="true"] .dp-close-icon {
    display: block;
  }

  /* MENU MOBILE */

  .dp-mobile-menu {
    display: none;
    padding: 0 5% 1.25rem;
    background: var(--sl-color-bg);
    border-top: 1px solid var(--sl-color-hairline);
  }

  .dp-mobile-navigation {
    display: flex;
    flex-direction: column;
  }

  .dp-mobile-link,
  .dp-mobile-dropdown > summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.9rem 0;
    color: var(--sl-color-text);
    text-decoration: none;
    font-weight: 600;
    border-bottom: 1px solid var(--sl-color-hairline);
    list-style: none;
    cursor: pointer;
  }

  .dp-mobile-dropdown > summary::-webkit-details-marker {
    display: none;
  }

  .dp-mobile-submenu {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    padding: 0.5rem 0 0.7rem 1rem;
    border-bottom: 1px solid var(--sl-color-hairline);
  }

  .dp-mobile-submenu a,
  .dp-mobile-disabled {
    padding: 0.65rem 0;
    color: var(--sl-color-text);
    text-decoration: none;
    font-size: 0.9rem;
  }

  .dp-mobile-disabled {
    color: var(--sl-color-gray-3);
    font-size: 0.82rem;
  }

  .dp-search-mobile {
    width: 100%;
    margin-top: 1rem;
  }

  /* TABLETS E CELULARES */

  @media (max-width: 900px) {
    .dp-header-inner {
      min-height: 68px;
      padding: 0.7rem 5%;
      gap: 0.8rem;
    }

    .dp-navigation,
    .dp-search-desktop {
      display: none;
    }

    .dp-mobile-toggle {
      display: flex;
      flex-shrink: 0;
    }

    .dp-mobile-menu:not([hidden]) {
      display: block;
    }
  }

  @media (max-width: 480px) {
    .dp-header-inner {
      min-height: 64px;
      gap: 0.6rem;
    }

    .dp-mobile-toggle {
      width: 40px;
      height: 40px;
    }
  }
</style>

<script>
  const header = document.querySelector('.dp-header');
  const toggle = header?.querySelector('.dp-mobile-toggle');
  const mobileMenu = header?.querySelector('#dp-mobile-menu');

  if (toggle && mobileMenu) {
    toggle.addEventListener('click', () => {
      const isExpanded = toggle.getAttribute('aria-expanded') === 'true';

      toggle.setAttribute('aria-expanded', String(!isExpanded));
      toggle.setAttribute(
        'aria-label',
        isExpanded ? 'Abrir menu' : 'Fechar menu'
      );

      mobileMenu.hidden = isExpanded;
    });

    mobileMenu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false');
        toggle.setAttribute('aria-label', 'Abrir menu');
        mobileMenu.hidden = true;
      });
    });
  }
</script>




