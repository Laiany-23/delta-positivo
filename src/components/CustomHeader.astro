
---
import SiteTitle from 'virtual:starlight/components/SiteTitle';
---

<header class="dp-header">
  <div class="dp-header-inner">

    <!-- LOGOTIPO -->
    <div class="dp-brand">
      <SiteTitle />
    </div>

    <!-- MENU DE NAVEGAÇÃO -->
    <nav class="dp-navigation" aria-label="Navegação principal">

      <a href="/" class="dp-nav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-6v-7h-4v7H4a1 1 0 0 1-1-1z"/>
        </svg>
        <span>Início</span>
      </a>

      <!-- MENU SUSPENSO DE ÁREAS -->
      <details class="dp-dropdown">
        <summary class="dp-nav-link">
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <rect x="3" y="3" width="7" height="7" rx="1"/>
            <rect x="14" y="3" width="7" height="7" rx="1"/>
            <rect x="3" y="14" width="7" height="7" rx="1"/>
            <rect x="14" y="14" width="7" height="7" rx="1"/>
          </svg>
          <span>Áreas</span>
          <svg class="dp-chevron" viewBox="0 0 24 24" aria-hidden="true">
            <path d="m6 9 6 6 6-6"/>
          </svg>
        </summary>

        <div class="dp-dropdown-menu">

          <a href="/areas/estruturas/" class="dp-dropdown-item">
            <strong>Estruturas</strong>
            <span>Materiais e sistemas estruturais</span>
          </a>

          <div class="dp-dropdown-item dp-disabled">
            <strong>Cargas</strong>
            <span>Em desenvolvimento</span>
          </div>

          <div class="dp-dropdown-item dp-disabled">
            <strong>Aeroelasticidade</strong>
            <span>Em desenvolvimento</span>
          </div>

          <div class="dp-dropdown-item dp-disabled">
            <strong>Aerodinâmica</strong>
            <span>Em desenvolvimento</span>
          </div>

        </div>
      </details>

      <!-- SOBRE -->
      <a href="/#sobre" class="dp-nav-link">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="9"/>
          <path d="M12 11v5"/>
          <path d="M12 7h.01"/>
        </svg>
        <span>Sobre</span>
      </a>

    </nav>

    <!-- BARRA DE PESQUISA -->
    <form class="dp-search" action="/search/" method="get" role="search">
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="10.8" cy="10.8" r="6.8"/>
        <path d="m16 16 5 5"/>
      </svg>

      <input
        type="search"
        name="q"
        placeholder="Pesquisar aulas e materiais..."
        aria-label="Pesquisar aulas e materiais"
      />
    </form>

  </div>
</header>

<style>
  /* CABEÇALHO */

  .dp-header {
    width: 100%;
    background: #FFFFFF;
    border-bottom: 1px solid #E5EAF0;
  }

  .dp-header-inner {
    width: 100%;
    min-height: 76px;
    padding: 0 4%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    box-sizing: border-box;
  }

  .dp-brand {
    flex-shrink: 0;
  }

  /* NAVEGAÇÃO */

  .dp-navigation {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }

  .dp-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: #10243D;
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
    white-space: nowrap;
    transition: color 0.2s ease;
  }

  .dp-nav-link:hover {
    color: #1769AA;
  }

  .dp-nav-link svg,
  .dp-search svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex-shrink: 0;
  }

  /* MENU SUSPENSO */

  .dp-dropdown {
    position: relative;
  }

  .dp-dropdown summary {
    list-style: none;
    cursor: pointer;
  }

  .dp-dropdown summary::-webkit-details-marker {
    display: none;
  }

  .dp-chevron {
    width: 15px !important;
    height: 15px !important;
    transition: transform 0.2s ease;
  }

  .dp-dropdown[open] .dp-chevron {
    transform: rotate(180deg);
  }

  .dp-dropdown-menu {
    position: absolute;
    top: calc(100% + 18px);
    left: -15px;
    width: 245px;
    padding: 8px;
    background: #FFFFFF;
    border: 1px solid #E1E8F0;
    border-radius: 12px;
    box-shadow: 0 10px 28px rgba(16,36,61,0.14);
    z-index: 100;
  }

  .dp-dropdown-item {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px;
    border-radius: 8px;
    text-decoration: none;
    color: #10243D;
    transition: background 0.2s ease;
  }

  a.dp-dropdown-item:hover {
    background: #EDF5FD;
  }

  .dp-dropdown-item strong {
    font-size: 0.92rem;
    font-weight: 700;
  }

  .dp-dropdown-item span {
    font-size: 0.78rem;
    color: #718096;
  }

  .dp-disabled {
    opacity: 0.65;
    cursor: default;
  }

  /* PESQUISA */

  .dp-search {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    width: min(340px, 30%);
    min-width: 190px;
    padding: 0.7rem 1rem;
    border: 1px solid #D6E0EA;
    border-radius: 10px;
    background: #F5F7FA;
    color: #526174;
    box-sizing: border-box;
  }

  .dp-search:focus-within {
    border-color: #1769AA;
    box-shadow: 0 0 0 3px rgba(23,105,170,0.12);
  }

  .dp-search input {
    width: 100%;
    min-width: 0;
    border: none;
    outline: none;
    background: transparent;
    color: #10243D;
    font: inherit;
    font-size: 0.88rem;
  }

  .dp-search input::placeholder {
    color: #718096;
  }

  /* TABLETS E CELULARES */

  @media (max-width: 760px) {

    .dp-header-inner {
      flex-wrap: wrap;
      justify-content: space-between;
      gap: 1rem;
      padding: 1rem 5%;
    }

    .dp-navigation {
      gap: 1rem;
    }

    .dp-search {
      width: 100%;
      min-width: 0;
      order: 3;
    }

  }

  @media (max-width: 400px) {

    .dp-nav-link {
      font-size: 0.85rem;
    }

    .dp-navigation {
      gap: 0.7rem;
    }

  }
</style>

